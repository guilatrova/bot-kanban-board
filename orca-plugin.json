{
  "manifestVersion": 2,
  "id": "bot-kanban-board",
  "name": "Bot Kanban Board",
  "version": "0.13.0",
  "publisher": "guilatrova",
  "license": "MIT",
  "description": "See every Orca bot's open Items and pull requests on one board, answer what needs you, and merge in one click.",
  "cover": {
    "path": "assets/cover.png",
    "alt": "All your bots, one board. Bot Kanban Board showing Needs you, In progress and pull requests ready to merge."
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker/index.ts",
  "engines": { "orca": ">=1.4.274" },
  "contributes": {
    "customEditors": [
      {
        "id": "board",
        "title": "Bot Kanban Board",
        "extensions": [".botkanban"],
        "entry": "editor/board.html",
        "frame": "isolated"
      }
    ],
    "commands": [
      { "id": "bot-kanban-board.open", "title": "Open Bot Kanban Board" },
      { "id": "bot-kanban-board.needs-you", "title": "Show Needs you" }
    ],
    "statusBarItems": [
      { "id": "needs-you", "text": "Needs you \u2026", "icon": "bell", "command": "bot-kanban-board.needs-you" }
    ],
    "events": [{ "on": "agent.status.changed" }],
    "settings": [
      { "key": "demo", "type": "boolean", "default": false, "title": "Demo data (restart plugin to apply)" },
      { "key": "orcaPath", "type": "string", "default": "", "title": "Orca executable path" },
      { "key": "ghPath", "type": "string", "default": "", "title": "GitHub CLI executable path" },
      {
        "key": "itemsSeconds",
        "type": "integer",
        "default": 60,
        "title": "Visible board item safety sweep interval (seconds)",
        "minimum": 30,
        "maximum": 3600
      },
      {
        "key": "prSeconds",
        "type": "integer",
        "default": 90,
        "title": "Pull request refresh interval (seconds)",
        "minimum": 10,
        "maximum": 3600
      }
    ]
  },
  "capabilities": [
    { "kind": "notifications:show" },
    { "kind": "storage:own" },
    { "kind": "settings:own" },
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    { "kind": "agent:read" }
  ]
}
